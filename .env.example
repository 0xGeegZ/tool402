# Dashboard sign-in. Development may use localhost over HTTP; every other origin must use HTTPS.
# Vercel Preview derives its changing origin from VERCEL_URL when this is empty.
TOOL402_DASHBOARD_AUTH_ORIGIN=http://localhost:3000
# Generate once per environment: openssl rand -hex 32
TOOL402_DASHBOARD_AUTH_SECRET=

# Convex development deployment
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=
