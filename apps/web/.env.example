# Next.js loads this file's local counterpart when the web app is its project
# root. Keep the actual values in the repository-root .env.local and link this
# path to it for local development so there is only one source of truth.
# Vercel Preview derives its changing origin from VERCEL_URL when this is empty.
TOOL402_DASHBOARD_AUTH_ORIGIN=https://localhost:3012
# Stage 4 derives the public RiskScan URL as <origin>/api/riskscan and publishes
# this canonical Hedera account as the clearing account. It is server-only.
TOOL402_CLEARING_ACCOUNT_ID=
# Generate once per environment: openssl rand -hex 32
TOOL402_DASHBOARD_AUTH_SECRET=
